# Copy to .env and fill in. Every key here is a *test/sandbox* credential: this server is a
# reference for the shape of the calls, not something to point at live money.
#
# The keys are read lazily, per provider, so you only need the ones you intend to exercise.

# Where this server listens. The demo app's VITE_PAYMENT_API_BASE_URL must agree with it.
PORT=4000

# The browser origin allowed through CORS, and where a redirect provider sends the shopper back.
CHECKOUT_ORIGIN=http://localhost:5173
CHECKOUT_RETURN_URL=http://localhost:5173/payment/return

# Stripe - https://dashboard.stripe.com/test/apikeys
# Secret key only. It never leaves this server; the browser must never see an sk_.
STRIPE_SECRET_KEY=sk_test_...

# Adyen - https://ca-test.adyen.com/ca/ca/config/api-credentials.shtml
ADYEN_API_KEY=AQE...
ADYEN_MERCHANT_ACCOUNT=YourMerchantAccountTEST

# PayPal - https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
