; The docs site resolves peers the way CI does.
;
; A machine with `legacy-peer-deps=true` set globally makes npm skip peer resolution, and the
; lockfile it writes then omits optional peers - `search-insights`, pulled in by the docsearch
; code VitePress bundles. `npm ci` on a default-configured machine rebuilds the tree, finds it
; missing from the lock, and refuses. Pinning it here keeps the lockfile portable.
;
; This is deliberately not set at the repository root: tsdown declares a peer on typescript@^5
; while the repo is on 7, so a root install genuinely needs the legacy behaviour.
legacy-peer-deps=false
