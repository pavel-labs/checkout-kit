{
  "name": "@checkout-kit/provider-hpp",
  "version": "0.0.0",
  "type": "module",
  "description": "Payment plugin for a hosted payment page: the shopper pays on the bank site and the merchant never sees a card.",
  "license": "Apache-2.0",
  "author": "themafia98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkout-kit/checkout-kit.git",
    "directory": "packages/provider-hpp"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@checkout-kit/conformance": "*",
    "@checkout-kit/testing": "*",
    "msw": "^2.15.0"
  }
}
