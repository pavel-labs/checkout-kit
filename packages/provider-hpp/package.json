{
  "name": "@checkout-kit/provider-hpp",
  "version": "0.1.0",
  "type": "module",
  "description": "Payment plugin for a hosted payment page: the shopper pays on the bank site and the merchant never sees a card.",
  "license": "Apache-2.0",
  "author": "pavel-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-labs/checkout-kit.git",
    "directory": "packages/provider-hpp"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "^0.1.0"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@checkout-kit/conformance": "*",
    "@checkout-kit/testing": "*",
    "msw": "^2.15.0"
  },
  "homepage": "https://pavel-labs.github.io/checkout-kit/",
  "keywords": [
    "checkout",
    "payments",
    "typescript",
    "headless",
    "provider-hpp"
  ]
}
