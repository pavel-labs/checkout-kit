{
  "name": "@checkout-kit/testing",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared test material: the card table every provider is exercised with, and an in-memory payment backend built on MSW.",
  "license": "Apache-2.0",
  "author": "pavel-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-labs/checkout-kit.git",
    "directory": "packages/testing"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "^0.1.0",
    "msw": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "msw": "^2.15.0"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./backend": {
      "@checkout-kit/source": "./src/backend/index.ts",
      "default": "./dist/backend/index.mjs"
    },
    "./engine": {
      "@checkout-kit/source": "./src/engine/index.ts",
      "default": "./dist/engine/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./backend": "./dist/backend/index.mjs",
      "./engine": "./dist/engine/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "homepage": "https://pavel-labs.github.io/checkout-kit/",
  "keywords": [
    "checkout",
    "payments",
    "typescript",
    "headless",
    "testing"
  ]
}
