{
  "name": "@checkout-kit/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Composable React 19 checkout components and scoped styles.",
  "license": "Apache-2.0",
  "author": "pavel-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-labs/checkout-kit.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "styles",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "^0.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./card": {
      "@checkout-kit/source": "./src/card/index.ts",
      "default": "./dist/card/index.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": "./dist/index.mjs",
      "./card": "./dist/card/index.mjs",
      "./styles.css": "./styles.css",
      "./package.json": "./package.json"
    }
  }
}
