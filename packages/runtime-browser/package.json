{
  "name": "@checkout-kit/runtime-browser",
  "version": "0.0.0",
  "type": "module",
  "description": "Browser half of the checkout: the runners that actually execute payment actions - iframes, top-level redirects, postMessage - plus session storage.",
  "license": "Apache-2.0",
  "author": "themafia98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkout-kit/checkout-kit.git",
    "directory": "packages/runtime-browser"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
