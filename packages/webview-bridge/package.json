{
  "name": "@checkout-kit/webview-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "The contract between a checkout running in a WebView and the native app hosting it.",
  "license": "Apache-2.0",
  "author": "pavel-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-labs/checkout-kit.git",
    "directory": "packages/webview-bridge"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@checkout-kit/core": "^0.1.0"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "@checkout-kit/source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./host": {
      "@checkout-kit/source": "./src/host/index.ts",
      "default": "./dist/host/index.mjs"
    },
    "./protocol": {
      "@checkout-kit/source": "./src/protocol/index.ts",
      "default": "./dist/protocol/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./host": "./dist/host/index.mjs",
      "./protocol": "./dist/protocol/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "@checkout-kit/testing": "*"
  },
  "homepage": "https://pavel-labs.github.io/checkout-kit/",
  "keywords": [
    "checkout",
    "payments",
    "typescript",
    "headless",
    "webview-bridge"
  ]
}
